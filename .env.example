# =============================================================================
# GridSentinel AI — Environment Configuration
# Copy this file to .env and fill in your actual IBM Cloud / watsonx.ai values
# NEVER commit the .env file — it is in .gitignore
# =============================================================================

# IBM watsonx.ai Credentials & Foundation Models
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Application Settings
APP_PORT=8000
APP_ENV=development
VITE_API_URL=http://localhost:8000

# Substation SCADA Settings (Real-Time Streaming / Demo Simulator)
SCADA_FEED_SOURCE=MQTT_TELEMETRY
ENABLE_OFFLINE_FALLBACK=true

# Real-Time MQTT Telemetry Stream (HiveMQ Cloud / Public Broker)
# Default public broker for zero-config testing: broker.hivemq.com (Port 1883)
# For HiveMQ Cloud: use your cluster host, port 8883, MQTT_USE_TLS=true, and credentials
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_PREFIX=grid/transformers

# Live Meteorological Weather API (Open-Meteo)
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHER_CACHE_TTL_SECONDS=120

# Google OAuth 2.0 Credentials (Create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Authorized Redirect URI registered in Google Cloud Console (FastAPI callback route):
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

